    <dashboard enable-sort-zone-taborder='true' name='Staffing Gap Check'>
      <style />
      <size maxheight='2400' maxwidth='1400' minheight='2400' minwidth='1400' sizing-mode='fixed' />
      <datasources>
        <datasource caption='call_center_analysis' name='federated.0skf50r1ub8ikw1gxopa11g5y9d8' />
      </datasources>

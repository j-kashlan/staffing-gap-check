      <aliases enabled='yes' />
      <column caption='Mismatch Rate' datatype='real' default-format='p0.0%' name='[Calculation_0611658334052352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IIF([staffing_status] &lt;&gt; &quot;Matched&quot;, 1, 0))' />
      </column>
      <column caption='Relative Gap' datatype='real' default-format='p0.0%' name='[Calculation_0611658334203905]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [staffing_status] &lt;&gt; &quot;Matched&quot; THEN ABS([gap]) / [required_fte] END' />
      </column>
      <column caption='Understaffed Rate' datatype='real' default-format='p0.0%' name='[Calculation_0611658338533379]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IIF([staffing_status] = &quot;Understaffed&quot;, 1, 0))' />
      </column>
      <column caption='Overall Understaffed Rate' datatype='real' default-format='p0.0%' name='[Calculation_0611658338590724]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : AVG(IIF([staffing_status] = &quot;Understaffed&quot;, 1, 0)) }' />
      </column>

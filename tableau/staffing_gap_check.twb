          <zones>
            <zone h='100000' id='37' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='99334' id='36' param='vert' type-v2='layout-flow' w='98858' x='571' y='333'>
                <zone forceUpdate='true' h='8709' id='3' type-v2='text' w='87286' x='571' y='333'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontsize='18'>Staffing Gap Check</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontsize='12'>Is the gap between planned and actual staffing a pattern, or noise?</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontsize='12'>Simulated data, 9,338 rows.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#555555' fontsize='12'>All data: 56.8% of rows match the plan, 94.4% are within one FTE.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontsize='12'>Mismatch rises with workload size (18.8% to 78.2%). A possible reason is that staff come in whole numbers (not tested).</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
